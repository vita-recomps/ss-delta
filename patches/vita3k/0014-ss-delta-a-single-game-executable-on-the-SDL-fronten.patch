diff --git a/vita3k/sdl-frontend/include/sdl-frontend/session.h b/vita3k/sdl-frontend/include/sdl-frontend/session.h
index 4a9cbc13..10448ec8 100644
--- a/vita3k/sdl-frontend/include/sdl-frontend/session.h
+++ b/vita3k/sdl-frontend/include/sdl-frontend/session.h
@@ -24,6 +24,7 @@
 
 struct EmuEnvState;
 struct SDL_Window;
+union SDL_Event;
 
 namespace app {
 class AppSessionController;
@@ -45,6 +46,10 @@ struct Hooks {
     std::function<void()> on_ime_changed;
     // The session is about to stop
     std::function<void()> on_stop;
+    // Every event the window receives, before the session handles it
+    std::function<void(const SDL_Event &event)> on_event;
+    // Every pass of the event loop (about 60 per second), after the runtime metrics are updated
+    std::function<void()> on_tick;
 };
 
 // Boots launch_request in an SDL window and runs it until the app exits or the window is closed,
diff --git a/vita3k/sdl-frontend/src/session.cpp b/vita3k/sdl-frontend/src/session.cpp
index 6c6de91c..041cfacf 100644
--- a/vita3k/sdl-frontend/src/session.cpp
+++ b/vita3k/sdl-frontend/src/session.cpp
@@ -291,6 +291,8 @@ int run(EmuEnvState &emuenv, app::AppSessionController &session, AppLaunchReques
         while (running) {
             SDL_Event event;
             while (SDL_PollEvent(&event)) {
+                if (hooks.on_event)
+                    hooks.on_event(event);
                 switch (event.type) {
                 case SDL_EVENT_QUIT:
                 case SDL_EVENT_WINDOW_CLOSE_REQUESTED:
@@ -357,6 +359,8 @@ int run(EmuEnvState &emuenv, app::AppSessionController &session, AppLaunchReques
             }
 
             app::update_runtime_metrics(emuenv, runtime_metrics);
+            if (hooks.on_tick)
+                hooks.on_tick();
 
             if (!session.is_running())
                 running = false;
diff --git a/vita3k/ss-delta/main.cpp b/vita3k/ss-delta/main.cpp
new file mode 100644
index 00000000..e8879e05
--- /dev/null
+++ b/vita3k/ss-delta/main.cpp
@@ -0,0 +1,203 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation; either version 2 of the License, or
+// (at your option) any later version.
+//
