From 3100e2163da6ff42579f78daf5208d34578cc66b Mon Sep 17 00:00:00 2001
From: alex <49746433+Master-Yoba@users.noreply.github.com>
Date: Sat, 10 Oct 2026 22:52:06 +0200
Subject: [PATCH] renderer/vulkan: split a scene without usable macroblocks
 before the next draw's textures

When a render target has macroblock sync but the scissor does not fit a
macroblock, every draw gets its own render pass, and without texture
viewports its own recording. The split happened at the draw, after the
draw's textures were synced. A texture read from the surface being
rendered is copied in the recording's prerender commands, which run
before the draws already in that recording, so the copy came from before
the previous draw: each draw sampled what the previous one had written a
frame earlier.

Soul Sacrifice Delta builds its depth-of-field and bloom blurs as chains
of tiles in one surface, each draw reading the tile the previous one
wrote. The lag added up along the chain (five frames for the last
tile), and the bloom trailed moving objects (the book in the main menu,
the butterfly on the title).

The split now happens at the first texture sync after a draw (or at the
draw if it has no textures), so the copy is recorded after the previous
draw.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vita3k/renderer/include/renderer/vulkan/types.h |  2 ++
 vita3k/renderer/src/vulkan/context.cpp          | 14 +++++++++++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/vita3k/renderer/include/renderer/vulkan/types.h b/vita3k/renderer/include/renderer/vulkan/types.h
index adee0741..420a1e20 100644
--- a/vita3k/renderer/include/renderer/vulkan/types.h
+++ b/vita3k/renderer/include/renderer/vulkan/types.h
@@ -319,6 +319,8 @@ struct VKContext : public renderer::Context {
     uint16_t last_macroblock_y = ~0;
     // special case where we can't determine the current macroblock
     bool ignore_macroblock = false;
+    // with ignore_macroblock, a draw was recorded since the render pass last restarted
+    bool drawn_since_macroblock_split = false;
 
     // used if necessary to restart easily the render pass
     vk::RenderPassBeginInfo curr_renderpass_info;
diff --git a/vita3k/renderer/src/vulkan/context.cpp b/vita3k/renderer/src/vulkan/context.cpp
index b54615f4..adc8765f 100644
--- a/vita3k/renderer/src/vulkan/context.cpp
+++ b/vita3k/renderer/src/vulkan/context.cpp
@@ -202,6 +202,7 @@ void set_context(VKContext &context, MemState &mem, VKRenderTarget *rt, const Fe
     context.last_macroblock_x = ~0;
     context.last_macroblock_y = ~0;
     context.ignore_macroblock = false;
+    context.drawn_since_macroblock_split = false;
 }
 
 void VKContext::start_recording(bool first_in_scene) {
@@ -528,7 +529,18 @@ void VKContext::check_for_macroblock_change(bool is_draw) {
     uint16_t curr_macroblock_x = scissor.offset.x / render_target->macroblock_width;
     uint16_t curr_macroblock_y = scissor.offset.y / render_target->macroblock_height;
 
-    if ((ignore_macroblock && is_draw) || curr_macroblock_x != last_macroblock_x || curr_macroblock_y != last_macroblock_y) {
+    // without a usable macroblock, every draw gets its own render pass (and, without texture
+    // viewports, its own recording). The split must come before the draw's textures are synced: a
+    // texture read from this surface is copied in the recording's prerender commands, which run
+    // before the draws already recorded. Splitting at the draw itself left that copy in the previous
+    // draw's recording, so each draw sampled what the previous one wrote a frame earlier (Soul
+    // Sacrifice Delta's blur chains: its bloom trailed moving objects)
+    const bool split_after_draw = ignore_macroblock && drawn_since_macroblock_split;
+    if (is_draw)
+        drawn_since_macroblock_split = true;
+    if (split_after_draw || curr_macroblock_x != last_macroblock_x || curr_macroblock_y != last_macroblock_y) {
+        if (split_after_draw)
+            drawn_since_macroblock_split = is_draw;
         // we changed the current macroblock, restart the renderpass
         last_macroblock_x = curr_macroblock_x;
         last_macroblock_y = curr_macroblock_y;
-- 
