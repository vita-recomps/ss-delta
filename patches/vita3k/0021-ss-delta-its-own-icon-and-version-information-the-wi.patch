From 54f7eb6f86037ca9f2bd0964b5ba2c2c98de0799 Mon Sep 17 00:00:00 2001
From: alex <49746433+Master-Yoba@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:16:38 +0200
Subject: [PATCH] ss-delta: its own icon and version information; the window
 shows the game's icon

ss-delta.rc replaces Vita3K.rc for ss-delta.exe: a plain red delta icon
(no game artwork), "Soul Sacrifice Delta (ss-delta)" as the description,
Vita3K's version numbers. The window takes the game's icon0.png from the
player's installed copy, falling back to the executable's icon.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vita3k/CMakeLists.txt        |   2 +-
 vita3k/ss-delta/main.cpp     |  14 +++++++++
 vita3k/ss-delta/ss-delta.ico | Bin 0 -> 17670 bytes
 vita3k/ss-delta/ss-delta.rc  |  55 +++++++++++++++++++++++++++++++++++
 4 files changed, 70 insertions(+), 1 deletion(-)
 create mode 100644 vita3k/ss-delta/ss-delta.ico
 create mode 100644 vita3k/ss-delta/ss-delta.rc

diff --git a/vita3k/CMakeLists.txt b/vita3k/CMakeLists.txt
index e31fa4e9..28a9c32f 100644
--- a/vita3k/CMakeLists.txt
+++ b/vita3k/CMakeLists.txt
@@ -473,7 +473,7 @@ if(WIN32)
 		ss-delta/main.cpp ss-delta/settings.cpp ss-delta/settings.h ss-delta/input.cpp ss-delta/input.h
 		interface.cpp interface.h performance.cpp
 		util/src/vc_runtime_checker.cpp
-		resource.h Vita3K.ico Vita3K.rc Windows.manifest)
+		resource.h ss-delta/ss-delta.ico ss-delta/ss-delta.rc Windows.manifest)
 	target_link_libraries(ss-delta PRIVATE app audio compat config ctrl dialog display ime lang gdbstub gxm io miniz modules motion packages patch renderer sdl-frontend shader touch util psvpfsparser pugixml::pugixml SDL3::SDL3 Version)
 	if(USE_DISCORD_RICH_PRESENCE)
 		target_link_libraries(ss-delta PRIVATE discord-rpc)
diff --git a/vita3k/ss-delta/main.cpp b/vita3k/ss-delta/main.cpp
index cba67063..4a653582 100644
--- a/vita3k/ss-delta/main.cpp
+++ b/vita3k/ss-delta/main.cpp
@@ -42,6 +42,7 @@
 #endif
 
 #include <SDL3/SDL.h>
+#include <stb_image.h>
 // provides WinMain for the windowed executable, which calls main below
 #include <SDL3/SDL_main.h>
 
@@ -132,6 +133,9 @@ int main(int argc, char *argv[]) {
     cfg.screen_filter = settings.filter;
     cfg.audio_volume = settings.volume;
 
+    // windows without an icon of their own get the executable's (ss-delta.rc)
+    SDL_SetHint(SDL_HINT_WINDOWS_INTRESOURCE_ICON, "101");
+    SDL_SetHint(SDL_HINT_WINDOWS_INTRESOURCE_ICON_SMALL, "101");
     SDL_SetHint(SDL_HINT_JOYSTICK_THREAD, "1");
     SDL_SetHint(SDL_HINT_JOYSTICK_ENHANCED_REPORTS, "1");
     SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI_SWITCH, "1");
@@ -178,6 +182,16 @@ int main(int argc, char *argv[]) {
         if (!window)
             return;
         SDL_SetWindowTitle(window, WINDOW_NAME);
+        // the game's own icon, from the player's installed copy
+        const fs::path icon_path = emuenv.vita_fs_path / "ux0" / "app" / TITLE_ID / "sce_sys" / "icon0.png";
+        int icon_w = 0, icon_h = 0, channels = 0;
+        if (stbi_uc *pixels = stbi_load(fs_utils::path_to_utf8(icon_path).c_str(), &icon_w, &icon_h, &channels, 4)) {
+            if (SDL_Surface *icon = SDL_CreateSurfaceFrom(icon_w, icon_h, SDL_PIXELFORMAT_RGBA32, pixels, icon_w * 4)) {
+                SDL_SetWindowIcon(window, icon);
+                SDL_DestroySurface(icon);
+            }
+            stbi_image_free(pixels);
+        }
         SDL_SetWindowSize(window, 960 * settings.window_scale, 544 * settings.window_scale);
         SDL_SetWindowPosition(window, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
         if (settings.fullscreen)
