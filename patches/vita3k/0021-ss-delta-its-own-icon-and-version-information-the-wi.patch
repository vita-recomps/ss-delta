+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// ss-delta.exe: its own icon (no game artwork; the window shows the game's icon at run time) and
+// version information. The version numbers are Vita3K's, which ss-delta is built from.
+
+#include "../resource.h"
+
+#include <windows.h>
+
+IDI_ICON1 ICON "ss-delta.ico"
+
+LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
+
+VS_VERSION_INFO VERSIONINFO
+ FILEVERSION FILE_VERSION
+ PRODUCTVERSION FILE_VERSION
+ FILEFLAGSMASK 0x3fL
+ FILEFLAGS 0x0L
+ FILEOS 0x40004L
+ FILETYPE 0x1L
+ FILESUBTYPE 0x0L
+BEGIN
+    BLOCK "StringFileInfo"
+    BEGIN
+        BLOCK "040904b0"
+        BEGIN
+            VALUE "FileDescription", "Soul Sacrifice Delta (ss-delta)"
+            VALUE "FileVersion", FILE_VERSION_STR "\0"
+            VALUE "InternalName", "ss-delta.exe"
+            VALUE "LegalCopyright", "GPLv2; built on Vita3K, Copyright (C) 2018-2026 Vita3K team"
+            VALUE "OriginalFilename", "ss-delta.exe"
+            VALUE "ProductName", "ss-delta"
+            VALUE "ProductVersion", FILE_VERSION_STR "\0"
+        END
+    END
+    BLOCK "VarFileInfo"
+    BEGIN
+        VALUE "Translation", 0x0409, 1200
+    END
+END
