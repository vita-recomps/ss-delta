+
+// Ahead-of-time recompiled guest code (ss-delta). Modules recompiled to C++ and built as DLLs
+// are listed in the SSD_AOT environment variable (';'-separated paths). The JIT stops at the
+// entry of every function such a module provides and the function runs natively instead; native
+// code calls back into the JIT for everything else (see dynarmic_cpu.cpp).
+#pragma once
+
+#include <mem/util.h>
+
+#include <cstdint>
+#include <string>
+
+struct MemState;
+
+namespace armrecomp {
+struct GuestContext;
+}
+
+using AotFn = void (*)(armrecomp::GuestContext *);
+
+// Load the modules named in SSD_AOT (once per process) and bind them to this guest memory.
+// sentinel is a guest address no code runs from: native code calling into the JIT returns there.
+void aot_init(MemState &mem, Address sentinel);
+void aot_deinit();
+
+bool aot_enabled();
+Address aot_sentinel();
+
+// The native function for a guest entry address (bit 0 set for Thumb), or null. A module's
+// functions become visible once its code has been checked against guest memory.
+AotFn aot_lookup(uint32_t addr);
+
+// Counters, logged every 10 s while native code runs and at deinit:
+// JIT -> native entries, native -> JIT calls (call_indirect, LLE import stubs), native -> HLE
+// calls, escapes (native -> JIT, abandoning native frames) and, with SSD_AOT_COUNT=1, the guest
+// instructions each side ran (the JIT through dynarmic's cycle counting, native code through
+// GuestContext::insns in modules built with RECOMP_COUNT_INSNS).
+bool aot_count_jit_insns();
+void aot_add_jit_insns(uint64_t n);
+void aot_add_native_insns(uint64_t n);
+void aot_count_native_entry();
+// Differential mode: SSD_AOT_DIFF=N checks every Nth native call per thread against the JIT
+uint64_t aot_diff_interval();
+void aot_count_diff(uint32_t pc, bool checked, bool mismatch, const char *skip_reason);
+void aot_count_diff_cost(uint64_t microseconds, uint64_t insns);
+void aot_note_mismatch(const std::string &text); // the last few appear in the counters text
+// JIT instructions run for a native -> JIT call to `key` (called) or from a top-level JIT run that
+// started at `key`; the counters text lists the heaviest
+void aot_profile_jit(uint32_t key, uint64_t insns, bool called);
+void aot_count_guest_call();
+void aot_count_import_call();
+void aot_count_escape(uint32_t pc);
+std::string aot_counters_text();
diff --git a/vita3k/cpu/include/cpu/aot_abi.h b/vita3k/cpu/include/cpu/aot_abi.h
new file mode 100644
index 00000000..bc11f636
--- /dev/null
+++ b/vita3k/cpu/include/cpu/aot_abi.h
@@ -0,0 +1,74 @@
+// Binary interface between a recompiled module (a DLL built from generated/<module>/ by ss-delta's
+// recomp/) and this runtime (cpu/src/aot.cpp). Identical to ss-delta's recomp/runtime/aot_abi.h;
+// bump AOT_ABI_VERSION in both on any change.
+#pragma once
+
+#include <cstdint>
+
+namespace armrecomp {
+
+constexpr uint32_t AOT_ABI_VERSION = 1;
+
+struct GuestContext {
+    uint32_t r[16]; // r15 holds the address of the last branch target written by generated code
+    // flags as 0/1 values; generated code reads and writes them directly
+    uint32_t n, z, c, v, q;
+    uint32_t ge; // GE[3:0]
+    union {
+        uint64_t d[32];
+        uint32_t s[64];
+        float f[64];
+        double fd[32];
+    } vfp;
+    uint32_t fpscr;
+    uint32_t tpidruro; // user read-only thread ID register (TLS), read by mrc p15, 0, rd, c13, c0, 3
+    // exclusive monitor
+    uint32_t excl_addr;
+    uint32_t excl_valid;
+    uint64_t excl_value;
+    void *embedder; // opaque pointer for the embedder
+    uint64_t insns; // guest instructions run natively, counted by modules built with RECOMP_COUNT_INSNS
+};
+
+// Provided by the runtime. The hooks have the semantics documented in armrecomp.h; escape and
+// unsupported must not return (they throw or longjmp).
+struct AotHost {
+    uint32_t abi_version;
+    uint32_t context_size; // sizeof(GuestContext)
+    uint8_t *guest_base;
+    void (*call_indirect)(GuestContext *ctx, uint32_t addr);
+    void (*call_import)(GuestContext *ctx, uint32_t stub_addr);
+    void (*escape)(GuestContext *ctx, uint32_t pc);
+    void (*unsupported)(GuestContext *ctx, uint32_t pc);
+};
+
+struct AotFunction {
+    uint32_t addr; // entry address, bit 0 set for Thumb
+    uint32_t size; // bytes of guest code (literal pools included) the function was generated from
+    void (*fn)(GuestContext *ctx);
+};
+
+// Provided by the module.
+struct AotModule {
+    uint32_t abi_version;
+    uint32_t context_size;
+    const char *name; // ELF file name the code was generated from
+    const AotFunction *functions; // sorted by address
+    uint32_t function_count;
+    // FNV-1a 64 over the `size` bytes of every function in `functions`, in table order, with the
+    // 4 bytes at every `patched` address read as zero: the runtime checks it against guest memory
+    // before running any native code
+    uint64_t code_hash;
+    // instructions the loader rewrites (variable imports), sorted; generated code reads their
+    // immediates from guest memory
+    const uint32_t *patched;
+    uint32_t patched_count;
+};
+
+// The module DLL exports `extern "C" const AotModule *armrecomp_aot_init(const AotHost *)`. It
+// returns null when the host's ABI version or context size does not match.
+using AotInitFn = const AotModule *(*)(const AotHost *host);
+
+} // namespace armrecomp
+
+#define ARMRECOMP_AOT_INIT "armrecomp_aot_init"
