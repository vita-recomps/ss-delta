+    std::array<VertexStreamLayout, SCE_GXM_MAX_VERTEX_STREAMS> stream_layouts;
+    for (uint32_t stream_index = 0; stream_index < std::min<size_t>(vertex_program.streams.size(), SCE_GXM_MAX_VERTEX_STREAMS); stream_index++)
