From 7de912912e337544543e5da2401bc1f89bbe97dc Mon Sep 17 00:00:00 2001
From: alex <49746433+Master-Yoba@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:20:43 +0200
Subject: [PATCH 4/6] renderer/vulkan: repack vertex streams with misaligned
 attribute offsets

Generalises the stride repacking. Vulkan also requires each attribute's
offset within the vertex to be a multiple of its component size; the
PS Vita does not. Soul Sacrifice Delta's cloth (the player's cloak) uses
a 16-bit attribute at an odd offset, which AMD fetches as garbage: the
cloak was speckled on the Radeon 760M (also in Vita3K-Plus).

get_vertex_stream_layout() decides per stream whether it can be fetched
in place (stride a multiple of 4 and every attribute offset aligned to
its component size, using the same effective format as
get_vertex_input_state). If not, every attribute gets its own 4-aligned
slot. bind_vertex_streams copies the stream into that layout, and
get_vertex_input_state uses the same offsets and stride. This replaces
restride_stream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../include/renderer/vulkan/functions.h       |  21 ++++
 vita3k/renderer/src/vulkan/pipeline_cache.cpp |  17 ++-
 vita3k/renderer/src/vulkan/scene.cpp          | 101 +++++++++++++++---
 3 files changed, 118 insertions(+), 21 deletions(-)

diff --git a/vita3k/renderer/include/renderer/vulkan/functions.h b/vita3k/renderer/include/renderer/vulkan/functions.h
index e791167e..92bc8f41 100644
--- a/vita3k/renderer/include/renderer/vulkan/functions.h
+++ b/vita3k/renderer/include/renderer/vulkan/functions.h
@@ -57,4 +57,25 @@ void sync_visibility_index(VKContext &context, bool enable, uint32_t index, bool
 
 void refresh_pipeline(VKContext &context);
 
+// Vulkan requires every vertex attribute address (offset + stride * index) to be a multiple of the
+// component size of its format, and Metal only allows strides that are a multiple of 4. The PS Vita
+// has neither restriction. A stream that breaks either rule is repacked into this layout, with every
+// attribute at a 4-aligned offset; NVIDIA tolerates the original layout but AMD fetches garbage.
+struct VertexStreamLayout {
+    struct Attribute {
+        uint32_t src_offset = 0;
+        uint32_t dst_offset = 0;
+        // number of bytes Vulkan fetches for this attribute
+        uint32_t size = 0;
+    };
+
+    bool repack = false;
+    // stride of the repacked stream (only meaningful if repack is true)
+    uint32_t stride = 0;
+    // indexed like SceGxmVertexProgram::attributes, only filled for the attributes of this stream
+    std::vector<Attribute> attributes;
+};
+
+VertexStreamLayout get_vertex_stream_layout(const SceGxmVertexProgram &vertex_program, uint32_t stream_index);
+
 } // namespace renderer::vulkan
