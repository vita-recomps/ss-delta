+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// The hooks recompiled code calls (aot_abi.h AotHost), for whichever CPU it runs on (AotOwner)
+
+#include <cpu/aot.h>
+#include <cpu/impl/aot_hooks.h>
+#include <cpu/impl/aot_owner.h>
+#include <util/log.h>
+
+namespace {
+
+AotOwner &aot_owner(armrecomp::GuestContext *ctx) {
+    return *static_cast<AotOwner *>(ctx->embedder);
+}
+
+} // namespace
+
+namespace aot_hooks {
+
+void call_indirect(armrecomp::GuestContext *ctx, uint32_t addr) {
+    if (const AotFn fn = aot_lookup(addr)) {
+        aot_owner(ctx).aot_call_native(addr, fn);
+        return;
+    }
+    if (!(addr & 1)) {
+        // ARM code without native code may be an import stub reached through a pointer (the
+        // eboot's __tls_get_addr): the import path calls its HLE function or native export
+        // directly, and anything else as aot_call_guest does
+        aot_owner(ctx).aot_call_import(addr);
+        return;
+    }
+    aot_owner(ctx).aot_call_guest(addr);
+}
+
+void call_import(armrecomp::GuestContext *ctx, uint32_t stub_addr) {
+    aot_owner(ctx).aot_call_import(stub_addr);
+}
+
+void escape(armrecomp::GuestContext *, uint32_t pc) {
+    aot_count_escape(pc);
+    throw AotEscape{ pc };
+}
+
+void unsupported(armrecomp::GuestContext *, uint32_t pc) {
+    LOG_ERROR("AOT: no native code for the instruction at {}", log_hex(pc));
+    aot_count_escape(pc);
+    throw AotEscape{ pc };
+}
+
+} // namespace aot_hooks
diff --git a/vita3k/cpu/src/cpu.cpp b/vita3k/cpu/src/cpu.cpp
index 25f1653b..8bc9afac 100644
--- a/vita3k/cpu/src/cpu.cpp
+++ b/vita3k/cpu/src/cpu.cpp
@@ -18,7 +18,9 @@
 #include <cpu/disasm/functions.h>
 #include <cpu/functions.h>
 #include <cpu/aot.h>
+#ifdef VITA3K_DYNARMIC
 #include <cpu/impl/dynarmic_cpu.h>
+#endif
 #include <cpu/impl/native_cpu.h>
 #include <cpu/impl/interface.h>
 #include <cpu/state.h>
@@ -49,11 +51,16 @@ CPUStatePtr init_cpu(bool cpu_opt, SceUID thread_id, std::size_t processor_id, M
         return CPUStatePtr();
     }
 
-    // ss-delta: SSD_AOT_NATIVE=1 runs threads on recompiled code alone, without the JIT
+    // ss-delta: SSD_AOT_NATIVE=1 runs threads on recompiled code alone, without the JIT; a build
+    // without the JIT (VITA3K_DYNARMIC=OFF) always does
+#ifdef VITA3K_DYNARMIC
     if (aot_native_cpu())
         state->cpu = std::make_unique<NativeCPU>(state.get(), processor_id);
     else
         state->cpu = std::make_unique<DynarmicCPU>(state.get(), processor_id, cpu_opt);
+#else
+    state->cpu = std::make_unique<NativeCPU>(state.get(), processor_id);
+#endif
 
     return state;
 }
