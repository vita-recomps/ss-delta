From 4586a6d35db5d03cf0ddb8c9cc0704fbfd55e4f8 Mon Sep 17 00:00:00 2001
From: alex <49746433+Master-Yoba@users.noreply.github.com>
Date: Sun, 11 Oct 2026 01:02:38 +0200
Subject: [PATCH] Build option VITA3K_DYNARMIC: a build without the JIT runs
 recompiled code only

With VITA3K_DYNARMIC=OFF, dynarmic and mcl are not built, the cpu library
leaves DynarmicCPU out and every thread runs on NativeCPU. The hooks of
recompiled code move to aot_hooks.cpp, shared by both backends.

Soul Sacrifice Delta's field runs at 30 fps from such a build, which has
no JIT at all.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                  |  2 +
 external/CMakeLists.txt         |  2 +
 vita3k/cpu/CMakeLists.txt       | 10 +++--
 vita3k/cpu/src/aot_hooks.cpp    | 65 +++++++++++++++++++++++++++++++++
 vita3k/cpu/src/cpu.cpp          |  9 ++++-
 vita3k/cpu/src/dynarmic_cpu.cpp | 37 -------------------
 6 files changed, 84 insertions(+), 41 deletions(-)
 create mode 100644 vita3k/cpu/src/aot_hooks.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d9edf977..f2117079 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -158,6 +158,8 @@ macro(boost_compile)
 	endif()
 endmacro(boost_compile)
 
+# ss-delta: without the JIT only recompiled code runs (cpu/impl/native_cpu.h)
+option(VITA3K_DYNARMIC "Build the dynarmic JIT" ON)
 option(VITA3K_FORCE_CUSTOM_BOOST "Force Vita3K build process to use the Boost version included with the repository" OFF)
 option(VITA3K_FORCE_SYSTEM_BOOST "Force Vita3K build process to use the Boost version in the system and CMake's default paths and ignore the Boost version included with Vita3K" OFF)
 
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 794f8368..c90d1305 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -121,6 +121,7 @@ if(WIN32)
 	target_link_libraries(winsock INTERFACE WSOCK32 WS2_32 IPHLPAPI)
 endif()
 
+if(VITA3K_DYNARMIC)
 set(DYNARMIC_TESTS OFF CACHE BOOL "")
 set(DYNARMIC_NO_BUNDLED_FMT ON CACHE BOOL "")
 set(DYNARMIC_FRONTENDS "A32" CACHE STRING "")
@@ -133,6 +134,7 @@ if(MSVC)
 		set_property(TARGET mcl PROPERTY COMPILE_OPTIONS ${MCL_COMPILE_OPTIONS})
 	endif()
 endif()
+endif()
 
 add_library(vita-toolchain INTERFACE)
 target_include_directories(vita-toolchain INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/vita-toolchain/src")
diff --git a/vita3k/cpu/CMakeLists.txt b/vita3k/cpu/CMakeLists.txt
index d02e75c5..3c7ad19a 100644
--- a/vita3k/cpu/CMakeLists.txt
+++ b/vita3k/cpu/CMakeLists.txt
@@ -6,16 +6,15 @@ include/cpu/common.h
 include/cpu/functions.h
 include/cpu/impl/aot_hooks.h
 include/cpu/impl/aot_owner.h
-include/cpu/impl/dynarmic_cpu.h
 include/cpu/impl/interface.h
 include/cpu/impl/native_cpu.h
 include/cpu/disasm/functions.h
 include/cpu/disasm/state.h
 
 src/aot.cpp
+src/aot_hooks.cpp
 src/disasm.cpp
 src/cpu.cpp
-src/dynarmic_cpu.cpp
 src/native_cpu.cpp
 )
 
@@ -29,4 +28,9 @@ source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR} FILES ${SOURCE_LIST})
 
 target_include_directories(cpu PUBLIC include)
 target_link_libraries(cpu PUBLIC mem util)
-target_link_libraries(cpu PRIVATE dynarmic capstone merry::mcl)
+target_link_libraries(cpu PRIVATE capstone)
+if(VITA3K_DYNARMIC)
+	target_sources(cpu PRIVATE include/cpu/impl/dynarmic_cpu.h src/dynarmic_cpu.cpp)
+	target_link_libraries(cpu PRIVATE dynarmic merry::mcl)
+	target_compile_definitions(cpu PRIVATE VITA3K_DYNARMIC=1)
+endif()
diff --git a/vita3k/cpu/src/aot_hooks.cpp b/vita3k/cpu/src/aot_hooks.cpp
new file mode 100644
index 00000000..897fdcc9
--- /dev/null
+++ b/vita3k/cpu/src/aot_hooks.cpp
@@ -0,0 +1,65 @@
+// Vita3K emulator project
+// Copyright (C) 2026 Vita3K team
