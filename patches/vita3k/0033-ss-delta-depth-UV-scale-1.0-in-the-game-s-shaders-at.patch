From 01bb4ca0de2b6af757b75ce64de061b90d260291 Mon Sep 17 00:00:00 2001
From: alex <49746433+Master-Yoba@users.noreply.github.com>
Date: Sun, 11 Oct 2026 20:12:03 +0200
Subject: [PATCH] ss-delta: depth UV scale 1.0 in the game's shaders at 960x544
 (full_3d)

The game's depth-of-field vertex shaders scale the depth texture
coordinates by 720/736 and 408/416 (literal table, consecutive entries):
right for its 720x408 mode, whose depth texture is padded to whole tiles,
2% short at 960x544. Near objects then took the background's depth and
its blur and haze (the hub's bones under a bluish band).

GxmState::on_program_registered: a frontend hook called with each program
the game registers. ss-delta.exe with full_3d sets the pair to 1.0 there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vita3k/gxm/include/gxm/state.h   |  5 +++++
 vita3k/modules/SceGxm/SceGxm.cpp |  2 ++
 vita3k/ss-delta/main.cpp         | 30 ++++++++++++++++++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/vita3k/gxm/include/gxm/state.h b/vita3k/gxm/include/gxm/state.h
index 7b12b74f..d6f5a90b 100644
--- a/vita3k/gxm/include/gxm/state.h
+++ b/vita3k/gxm/include/gxm/state.h
@@ -17,6 +17,7 @@
 
 #pragma once
 
+#include <functional>
 #include <gxm/types.h>
 #include <mem/ptr.h>
 #include <threads/queue.h>
@@ -57,6 +58,10 @@ struct MemoryMapInfo {
 struct GxmState {
     SceGxmInitializeParams params;
 
+    // called with each program the game registers with the shader patcher, before it is used: a
+    // frontend can adjust a game's shaders here (ss-delta: UV scales for its full-resolution mode)
+    std::function<void(SceGxmProgram &program)> on_program_registered;
+
     Queue<DisplayCallback> display_queue;
     SceUID display_queue_thread;
     std::thread display_host_thread;
diff --git a/vita3k/modules/SceGxm/SceGxm.cpp b/vita3k/modules/SceGxm/SceGxm.cpp
index 89a3195a..68553493 100644
--- a/vita3k/modules/SceGxm/SceGxm.cpp
+++ b/vita3k/modules/SceGxm/SceGxm.cpp
@@ -4794,6 +4794,8 @@ EXPORT(int, sceGxmShaderPatcherRegisterProgram, SceGxmShaderPatcher *shaderPatch
 
     SceGxmRegisteredProgram *const rp = programId->get(emuenv.mem);
     rp->program = programHeader;
+    if (emuenv.gxm.on_program_registered)
+        emuenv.gxm.on_program_registered(*const_cast<SceGxmProgram *>(programHeader.get(emuenv.mem)));
 
     return 0;
 }
diff --git a/vita3k/ss-delta/main.cpp b/vita3k/ss-delta/main.cpp
index 62787257..41415ffb 100644
--- a/vita3k/ss-delta/main.cpp
+++ b/vita3k/ss-delta/main.cpp
@@ -39,6 +39,8 @@
 #include <mem/ptr.h>
 #include <renderer/state.h>
 #include <ime/functions.h>
+#include <gxm/state.h>
+#include <gxm/types.h>
 #include <io/functions.h>
 #include <io/state.h>
 #include <modules/module_parent.h>
@@ -60,6 +62,7 @@
 
 #include <chrono>
 #include <cstdlib>
+#include <cstring>
 #include <ctime>
 #include <iterator>
 #include <map>
@@ -196,6 +199,31 @@ void override_boot_config(EmuEnvState &emuenv, const fs::path &dir, const std::m
     emuenv.io.read_overrides[read_override_key(installed)] = copy;
 }
 
+// With the 3D at 960x544 (full_3d), the game samples its depth buffer through vertex shaders that
+// scale the coordinates by 720/736 and 408/416: right for the 720x408 mode, whose depth texture is
+// padded to whole 32-pixel tiles (1472x832 samples), 2% short at 960x544, which needs no padding.
+// Depth of field and haze then use the depth beside each pixel (bones in the hub blurred). Both
+// values are in the shaders' literal table, a list of {u32 register, f32 value}, as consecutive
+// entries; they are set to 1.0 there.
+void unscale_depth_uvs(SceGxmProgram &program) {
+    constexpr uint32_t x_scale = 0x3f7a6f4e; // 720 / 736
+    constexpr uint32_t y_scale = 0x3f7b13b2; // 408 / 416
+    constexpr uint32_t one = 0x3f800000;
+    uint8_t *const bytes = reinterpret_cast<uint8_t *>(&program);
+    int replaced = 0;
+    for (uint32_t i = 0; i + 12 <= program.size; i += 4) {
+        uint32_t x, y;
+        std::memcpy(&x, bytes + i, 4);
+        std::memcpy(&y, bytes + i + 8, 4);
+        if (x == x_scale && y == y_scale) {
+            std::memcpy(bytes + i, &one, 4);
+            std::memcpy(bytes + i + 8, &one, 4);
+            replaced++;
+        }
+    }
+    LOG_INFO_IF(replaced, "full_3d: depth UV scale set to 1.0 in a {} shader", program.is_vertex() ? "vertex" : "fragment");
+}
+
 // The 60 fps study (docs/03-plan.md Phase 8): the game paces its main loop with a frame timer
 // created for 30 fps (0x812ab888: movs r0, #30), whose period in microseconds is the first u64 of
 // the timer object (*(*0x81c957cc)), and flips every 2nd vblank (threshold at 0x81d3a630). Both
@@ -428,6 +456,8 @@ int main(int argc, char *argv[]) {
     for (const auto &[key, value] : settings.boot_config)
         boot_config[key] = value;
     override_boot_config(emuenv, data_dir / "game", boot_config);
+    if (settings.full_3d)
+        emuenv.gxm.on_program_registered = unscale_depth_uvs;
 
     // window: size and fullscreen from the settings, F11 or Alt+Enter switch, frame rate in the title
     SDL_Window *window = nullptr;
-- 
